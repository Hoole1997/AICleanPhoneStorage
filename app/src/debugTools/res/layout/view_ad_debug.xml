<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        style="@style/Widget.Home.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/ad_debug_description"
        android:textColor="@color/home_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Home.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ad_debug_controls_heading"
                style="@style/Widget.Home.Text.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ad_debug_controls"
                android:textColor="@color/home_title"
                android:textSize="17sp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ad_debug_global_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/ad_debug_global_enabled"
                android:textColor="@color/home_title"
                android:textSize="15sp" />
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Home.Text.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/ad_debug_source"
                android:text="@string/ad_debug_source"
                android:textColor="@color/home_title"
                android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/ad_debug_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:prompt="@string/ad_debug_source"
                android:spinnerMode="dialog" />
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Home.Text.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/ad_debug_format"
                android:text="@string/ad_debug_format"
                android:textColor="@color/home_title"
                android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/ad_debug_format"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:prompt="@string/ad_debug_format"
                android:spinnerMode="dialog" />
            <ProgressBar
                android:id="@+id/ad_debug_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/ad_debug_showing"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ad_debug_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/ad_debug_show"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ad_debug_refresh"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ad_debug_refresh"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ad_debug_reset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ad_debug_reset"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ad_debug_clear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ad_debug_clear"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ad_debug_max_debugger"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ad_debug_max_debugger"
                android:textAllCaps="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ad_debug_result_heading"
        style="@style/Widget.Home.Text.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ad_debug_result"
        android:textColor="@color/home_title"
        android:textSize="17sp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ad_debug_result"
        style="@style/Widget.Home.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/ad_debug_no_result"
        android:textColor="@color/home_text_primary"
        android:textIsSelectable="true"
        android:textSize="14sp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ad_debug_diagnostics_heading"
        style="@style/Widget.Home.Text.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ad_debug_diagnostics"
        android:textColor="@color/home_title"
        android:textSize="17sp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ad_debug_diagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:includeFontPadding="true"
        android:textColor="@color/home_text_secondary"
        android:textIsSelectable="true"
        android:textSize="12sp" />
</LinearLayout>
