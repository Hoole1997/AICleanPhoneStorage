<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 使用情况访问是系统设置中的特殊访问权，不能用普通运行时权限对话框申请。 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- 旧系统移动网络查询按需读取 subscriberId；Android 10+ 直接查询全部移动网络。 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- 显式移除第三方 SDK 的全量包查询权限；已安装应用遵循系统包可见性规则。
         Lint 检查源清单时不识别 remove，仅在此移除节点忽略误报，成品不包含此权限。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="remove" tools:ignore="QueryAllPackagesPermission" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name=".app.CleanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        tools:replace="android:supportsRtl,android:usesCleartextTraffic"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AICleanPhoneStorage">
        <!-- 本功能只使用前台自定义 cloudScan，不启用 SDK 的周期后台任务服务。 -->
        <service android:name="com.trustlook.sdk.job.TlJobService" tools:node="remove" />
        <meta-data android:name="com.trustlook.ApiKey" android:value="${TRUSTLOOK_API_KEY}" />
        <activity android:name=".feature.malware.ui.MalwareScanActivity" android:screenOrientation="portrait" android:exported="false" />
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${ADMOB_APPLICATION_ID}" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_home_clean" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="general_notification_v2" />
        <activity android:name=".feature.battery.ui.BatteryInfoActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.settings.SettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.settings.LanguageSettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.settings.FeedbackActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.settings.AboutActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".core.ui.completion.CompletionActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.junkcleaner.ui.JunkCleaningActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.appmanager.ui.AppManagerActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.filecleaner.ui.FileCleanupActivity" android:screenOrientation="portrait" android:exported="false" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.cleanup.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/cleanup_file_paths" />
        </provider>
        <activity android:name=".feature.networktraffic.ui.NetworkTrafficActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".feature.notifications.ui.NotificationCleanerActivity" android:screenOrientation="portrait" android:exported="false" />
        <!-- 只能由Android通知管理器绑定；不是可被其他应用启动的普通服务。 -->
        <service android:name=".feature.notifications.service.NotificationCleanerService"
            android:label="@string/notification_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity android:name=".app.MainActivity" android:screenOrientation="portrait" android:launchMode="singleTask" android:exported="false" />
        <activity android:name=".feature.startup.StartupActivity" android:screenOrientation="portrait" android:launchMode="singleTop"
            android:exported="true" android:theme="@style/Theme.AICleanPhoneStorage.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.docview.push.ACTION_OPEN_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
