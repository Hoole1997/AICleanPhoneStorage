<resources>
    <style name="Theme.Retention" parent="Theme.AICleanPhoneStorage">
        <!-- 页面根节点提供背景，避免窗口再绘制一层同色背景。 -->
        <item name="android:windowBackground">@null</item>
    </style>
    <color name="retention_background">#EEF6FF</color>
    <color name="retention_blue">#0D60F1</color>
    <color name="retention_reason_blue">#166CFE</color>
    <color name="retention_red">#E65058</color>
    <color name="retention_text">#333333</color>
    <dimen name="retention_gutter">16dp</dimen>
    <style name="Retention.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginHorizontal">14dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/retention_blue</item>
    </style>
    <style name="Retention.ReasonPrimary" parent="Retention.Primary">
        <item name="backgroundTint">@color/retention_reason_blue</item>
    </style>
    <style name="Retention.Link" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/retention_red</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="Retention.Reason" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/retention_text</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:drawableEnd">@drawable/retention_radio</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:includeFontPadding">true</item>
    </style>
</resources>
