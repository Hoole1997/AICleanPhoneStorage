<resources>
<color name="traffic_blue">#0D60F1</color>
<color name="traffic_text">#444444</color>
<color name="traffic_secondary">#5E74A1</color>
<color name="traffic_track">#EBEBEB</color>
<color name="task_ad_background">#EDF4FF</color>
<style name="Widget.Traffic.Button" parent="Widget.MaterialComponents.Button">
    <item name="android:fontFamily">@font/home_roboto_medium</item><item name="fontFamily">@font/home_roboto_medium</item>
    <item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item>
    <item name="android:letterSpacing">0</item><item name="android:includeFontPadding">false</item>
    <item name="android:minHeight">48dp</item><item name="android:minWidth">64dp</item>
    <item name="android:paddingStart">12dp</item><item name="android:paddingEnd">12dp</item>
    <item name="android:insetTop">8dp</item><item name="android:insetBottom">8dp</item>
    <item name="cornerRadius">8dp</item><item name="backgroundTint">@color/traffic_blue</item>
    <item name="android:textColor">@color/home_surface</item><item name="android:elevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
</style>
<style name="Widget.Traffic.Filter" parent="Widget.MaterialComponents.Chip.Choice">
    <item name="android:fontFamily">@font/home_roboto_regular</item><item name="fontFamily">@font/home_roboto_regular</item>
    <item name="android:textSize">14sp</item><item name="android:textColor">@color/traffic_filter_text</item>
    <item name="chipBackgroundColor">@color/traffic_filter_background</item><item name="chipCornerRadius">24dp</item>
    <item name="chipStrokeWidth">0dp</item><item name="checkedIconVisible">false</item>
    <item name="chipMinHeight">36dp</item><item name="ensureMinTouchTargetSize">true</item>
</style>
</resources>
