<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView android:id="@+id/settings_item_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginLeft="20dp"
        android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no"
        app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <com.google.android.material.textview.MaterialTextView android:id="@+id/settings_item_title" style="@style/Widget.Home.Text.Medium"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
        android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:textSize="16sp" android:textColor="@color/home_title"
        android:textAlignment="viewStart" android:textDirection="firstStrong" android:importantForAccessibility="no"
        app:layout_constraintLeft_toRightOf="@id/settings_item_icon" app:layout_constraintRight_toLeftOf="@id/settings_item_arrow"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <ImageView android:id="@+id/settings_item_arrow" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginRight="20dp"
        android:src="@drawable/ic_app_manager_next" android:contentDescription="@null" android:importantForAccessibility="no"
        app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
</merge>
