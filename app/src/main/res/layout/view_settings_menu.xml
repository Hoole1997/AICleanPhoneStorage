<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Home.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_language"
                style="@style/Widget.Settings.Row"
                android:text="@string/settings_language" />
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_settings_language"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="20dp"
            android:background="#EFF2F7" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_privacy"
                style="@style/Widget.Settings.Row"
                android:text="@string/settings_privacy" />
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_settings_privacy"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="20dp"
            android:background="#EFF2F7" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_feedback"
                style="@style/Widget.Settings.Row"
                android:text="@string/settings_feedback" />
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_settings_feedback"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="20dp"
            android:background="#EFF2F7" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_about"
                style="@style/Widget.Settings.Row"
                android:text="@string/settings_about" />
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_settings_about"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
