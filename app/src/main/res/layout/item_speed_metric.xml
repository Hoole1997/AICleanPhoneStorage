<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 6554:851：12dp 图标 + 11sp 标签；数值 14sp 与单位 12sp 按基线对齐。长翻译允许换行，
     各列等高、标签顶对齐、数值底对齐，某列标签换行时三列数值仍在同一水平线。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
    android:gravity="center_horizontal" android:focusable="true" android:paddingHorizontal="4dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/metric_icon" android:layout_width="12dp" android:layout_height="12dp"
            android:importantForAccessibility="no" android:contentDescription="@null" tools:src="@drawable/ic_speed_ping" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/metric_label" style="@style/Widget.Home.Text"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp"
            android:textSize="11sp" android:textColor="@color/speed_metric_label" android:gravity="center" android:maxLines="2"
            tools:text="Ping" />
    </LinearLayout>
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:baselineAligned="true">
        <com.google.android.material.textview.MaterialTextView android:id="@+id/metric_value" style="@style/Widget.Home.Text.Medium"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="@color/speed_metric_value" tools:text="69" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/metric_unit" style="@style/Widget.Home.Text"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp"
            android:textSize="12sp" android:textColor="@color/speed_metric_label" android:text="@string/speed_test_unit_ms" />
    </LinearLayout>
</LinearLayout>
