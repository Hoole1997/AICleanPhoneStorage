<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="68dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="16dp" android:background="@drawable/bg_new_user_card">
    <ImageView android:id="@+id/itemIcon" android:layout_width="32dp" android:layout_height="32dp"
        android:importantForAccessibility="no" />
    <!-- 文本自然测量；大字体/长型号允许换行，不能固定卡片高度裁切字形。 -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        android:orientation="vertical">
        <TextView android:id="@+id/itemTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
            android:textSize="14sp" android:textColor="@color/new_user_title" />
        <TextView android:id="@+id/itemValue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:fontFamily="sans-serif" android:includeFontPadding="false"
            android:textSize="12sp" android:textColor="@color/new_user_value" />
    </LinearLayout>
    <ImageView android:id="@+id/itemStatus" android:layout_width="22dp" android:layout_height="22dp"
        android:importantForAccessibility="no" android:src="@drawable/new_user_loading" />
</LinearLayout>
