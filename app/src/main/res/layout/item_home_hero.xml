<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Home.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/home_hero_blue">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/hero_layout"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/home_hero_min_height">
        <ImageView android:id="@+id/hero_background" android:layout_width="0dp" android:layout_height="0dp"
            android:src="@drawable/home_hero_background" android:scaleType="fitXY"
            android:importantForAccessibility="no" android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <!-- 原版整组插画已烘焙为透明 WebP，不在客户端实时绘制模糊或阴影；动效仅使用 RenderNode 变换。 -->
        <ImageView android:id="@+id/robot_art" android:layout_width="@dimen/home_robot_width"
            android:layout_height="@dimen/home_robot_height" android:layout_marginTop="@dimen/home_robot_top"
            android:src="@drawable/home_robot" android:scaleType="fitCenter"
            android:importantForAccessibility="no" android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/summary_column" android:layout_width="0dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="17dp" android:layout_marginEnd="8dp"
            android:layout_marginTop="24dp" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/robot_art">
            <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Medium" android:id="@+id/summary_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Home.Label" android:textColor="@color/home_surface"
                tools:text="Storage Used" />
            <!-- 容量按字体自然测量高度，单位约束到数字基线，不把 Figma 行高当成固定 View 高度。 -->
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Black"
                    android:id="@+id/summary_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Home.Value" tools:text="40.3"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Medium"
                    android:id="@+id/summary_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:textAppearance="@style/TextAppearance.Home.Caption"
                    android:textColor="@color/home_surface" tools:text="GB"
                    app:layout_constraintStart_toEndOf="@id/summary_value"
                    app:layout_constraintBaseline_toBaselineOf="@id/summary_value" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text" android:id="@+id/scan_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:textAppearance="@style/TextAppearance.Home.Caption"
                android:textColor="@color/home_surface" tools:text="of 128GB" />
            <ProgressBar android:id="@+id/usage_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="10dp"
                android:indeterminate="false" android:max="10000" android:progressDrawable="@drawable/home_usage_progress"
                android:importantForAccessibility="no" />
            <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Medium" android:id="@+id/usage_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textAppearance="@style/TextAppearance.Home.Caption"
                android:fontFamily="@font/home_roboto_medium" android:textColor="@color/home_surface" tools:text="31% used" />
        </LinearLayout>
        <androidx.constraintlayout.widget.Barrier android:id="@+id/hero_content_bottom"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:barrierDirection="bottom" app:constraint_referenced_ids="summary_column,robot_art" />
        <com.example.aicleanphonestorage.core.ui.motion.ShimmerPillButton android:id="@+id/clean_button"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp"
            android:layout_marginStart="29dp" android:layout_marginEnd="29dp"
            android:layout_marginTop="12dp" android:layout_marginBottom="24dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/home_smart_clean"
            android:textAppearance="@style/TextAppearance.Home.Label" android:textSize="16sp" android:fontFamily="@font/home_roboto_semibold" app:fontFamily="@font/home_roboto_semibold"
            android:textColor="@color/home_blue" android:textAllCaps="false" android:letterSpacing="0"
            android:elevation="0dp" android:stateListAnimator="@animator/home_clean_press" app:backgroundTint="@color/home_surface"
            app:cornerRadius="100dp" app:strokeWidth="0dp" app:rippleColor="@color/home_ripple"
            app:icon="@drawable/ic_home_clean" app:iconSize="22dp" app:iconPadding="8dp" app:iconTint="@null"
            app:iconGravity="textStart" app:layout_constraintTop_toBottomOf="@id/hero_content_bottom"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
