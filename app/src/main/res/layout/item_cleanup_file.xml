<?xml version="1.0" ?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingTop="9dp" android:paddingBottom="9dp">
    <ImageView android:id="@+id/file_icon" android:layout_width="42dp" android:layout_height="42dp" android:scaleType="centerCrop" android:importantForAccessibility="no" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
