<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="false" android:scrollbars="none">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <!-- 插画所在的透明区域属于弹层内容，不依赖负边距或窗口外绘制。 -->
        <LinearLayout android:id="@+id/permission_panel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="64dp" android:minHeight="279dp"
            android:orientation="vertical" android:paddingTop="62dp" android:paddingBottom="34dp"
            android:background="@drawable/permission_sheet_surface">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/permission_title" style="@style/Widget.Home.Text.Medium"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:gravity="center"
                android:textSize="18sp" android:textColor="#333333" />
            <!-- 说明区保留设计稿三行的最小空间；长文案和大字号仍按实际字体自然增高。 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/permission_message" style="@style/Widget.Home.Text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp" android:layout_marginTop="10dp"
                android:gravity="top|center_horizontal" android:minHeight="60dp"
                android:textSize="14sp" app:lineHeight="20sp"
                android:textColor="#666666" />
            <com.example.aicleanphonestorage.core.permissions.PermissionActionsLayout
                android:id="@+id/permission_actions"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/permission_cancel" style="@style/Widget.Clean.PermissionAction.Secondary"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="13dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/permission_continue" style="@style/Widget.Clean.PermissionAction"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </com.example.aicleanphonestorage.core.permissions.PermissionActionsLayout>
        </LinearLayout>
        <ImageView android:layout_width="63dp" android:layout_height="8dp"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="102dp"
            android:src="@drawable/permission_sheet_shadow" android:scaleType="fitCenter"
            android:contentDescription="@null" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/permission_icon"
            android:layout_width="93dp" android:layout_height="100dp"
            android:layout_gravity="top|center_horizontal" android:scaleType="fitCenter"
            android:contentDescription="@null" android:importantForAccessibility="no" />
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
