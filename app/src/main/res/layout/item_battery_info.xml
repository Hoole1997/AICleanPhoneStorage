<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Home.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp">
