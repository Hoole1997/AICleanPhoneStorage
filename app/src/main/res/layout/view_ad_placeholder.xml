<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp"
    android:background="@drawable/task_ad_surface" android:gravity="center_vertical" android:padding="12dp">
    <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Medium"
        android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="@string/task_ad_label"
        android:textSize="12sp" android:textColor="@color/traffic_blue" android:background="@drawable/task_dialog_surface"/>
    <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Medium"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
        android:text="@string/task_ad_placeholder" android:textColor="@color/traffic_text" android:textSize="14sp"/>
</LinearLayout>
