<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false" android:scrollbars="none">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/rating_content" android:layout_width="match_parent" android:layout_height="wrap_content">
        <View android:id="@+id/rating_handle" android:layout_width="66dp" android:layout_height="8dp" android:layout_marginTop="20dp" android:background="@drawable/rating_drag_handle" android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <ImageView android:id="@+id/rating_illustration" android:layout_width="116dp" android:layout_height="116dp" android:layout_marginTop="16dp" android:src="@drawable/rating_illustration" android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/rating_handle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/rating_title" style="@style/Widget.Home.Text.Bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginHorizontal="30dp" android:gravity="center" android:textSize="18sp" android:textColor="#333333" android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/rating_illustration" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/rating_message" style="@style/Widget.Home.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginHorizontal="30dp" android:gravity="center" android:text="@string/rating_message" android:textSize="14sp" android:textColor="#999999" android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/rating_title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/rating_hint" style="@style/Widget.Home.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="129dp" android:minHeight="38dp" android:layout_marginTop="18dp" android:background="@drawable/rating_hint" android:paddingHorizontal="10dp" android:paddingTop="8dp" android:paddingBottom="14dp" android:gravity="center" android:text="@string/rating_hint" android:textSize="11sp" android:textColor="@android:color/white" android:includeFontPadding="false" app:layout_constrainedWidth="true"
            app:layout_constraintTop_toBottomOf="@id/rating_message" app:layout_constraintStart_toStartOf="@id/rating_stars" app:layout_constraintEnd_toEndOf="@id/rating_stars" app:layout_constraintHorizontal_bias="1" />
        <LinearLayout android:id="@+id/rating_stars" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginHorizontal="8dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" app:layout_constraintWidth_max="304dp"
            app:layout_constraintTop_toBottomOf="@id/rating_hint" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/rating_star_1" style="@style/Widget.Clean.RatingStar" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/rating_star_2" style="@style/Widget.Clean.RatingStar" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/rating_star_3" style="@style/Widget.Clean.RatingStar" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/rating_star_4" style="@style/Widget.Clean.RatingStar" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/rating_star_5" style="@style/Widget.Clean.RatingStar" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/rating_submit" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="20dp" android:layout_marginHorizontal="30dp" android:layout_marginBottom="40dp" android:paddingVertical="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:includeFontPadding="false" android:textAllCaps="false" android:letterSpacing="0" android:text="@string/rating_submit" android:textSize="16sp" android:fontFamily="@font/home_roboto_regular" android:textColor="@android:color/white" app:backgroundTint="#0D60F1" app:cornerRadius="24dp"
            app:layout_constraintTop_toBottomOf="@id/rating_stars" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
