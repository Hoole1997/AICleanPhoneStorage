<?xml version="1.0" ?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="0dp" android:layout_height="334dp" android:src="@drawable/home_header_background" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout android:id="@+id/cleanup_content" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" app:layout_constraintWidth_max="600dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="8dp">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/cleanup_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_traffic_back" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/traffic_back"/>
            <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Bold" android:id="@+id/cleanup_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="18sp" android:textColor="@color/home_title"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.MaterialComponents.Button.TextButton" android:id="@+id/cleanup_select_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textSize="12sp" android:textAllCaps="false" android:text="@string/cleanup_select_all"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cleanup_photo_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="16dp" android:textSize="18sp" android:textColor="#666666" android:text="@string/cleanup_photo_summary"/>
            <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text.Semibold" android:id="@+id/cleanup_potential" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="40dp" android:padding="12dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/home_surface" android:background="@drawable/cleanup_badge"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/cleanup_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@drawable/task_dialog_surface" android:visibility="gone">
            <com.google.android.material.button.MaterialButton style="@style/Widget.MaterialComponents.Button.TextButton" android:id="@+id/cleanup_type" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="4dp" android:textSize="14sp" android:textAllCaps="false" app:icon="@drawable/cleanup_chevron_down" app:iconSize="12dp" app:iconGravity="textEnd" app:iconTint="@null"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.MaterialComponents.Button.TextButton" android:id="@+id/cleanup_size" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="4dp" android:textSize="14sp" android:textAllCaps="false" app:icon="@drawable/cleanup_chevron_down" app:iconSize="12dp" app:iconGravity="textEnd" app:iconTint="@null"/>
            <com.google.android.material.button.MaterialButton style="@style/Widget.MaterialComponents.Button.TextButton" android:id="@+id/cleanup_age" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="4dp" android:textSize="14sp" android:textAllCaps="false" app:icon="@drawable/cleanup_chevron_down" app:iconSize="12dp" app:iconGravity="textEnd" app:iconTint="@null"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton style="@style/Widget.MaterialComponents.Button.TextButton" android:id="@+id/cleanup_unused_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:minHeight="48dp" android:textAllCaps="false" android:visibility="gone"/>
        <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text" android:id="@+id/cleanup_scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp" android:textSize="12sp" android:textColor="@color/home_text_secondary" android:visibility="gone"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/cleanup_files" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="108dp" android:clipToPadding="false" android:scrollbars="none"/>
            <com.google.android.material.textview.MaterialTextView style="@style/Widget.Home.Text" android:id="@+id/cleanup_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="24dp" android:gravity="center" android:textSize="16sp" android:text="@string/cleanup_no_files" android:visibility="gone"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:layout_gravity="bottom" android:orientation="vertical" android:paddingTop="22dp" android:paddingBottom="20dp" android:background="@drawable/cleanup_footer_fade">
                <com.google.android.material.button.MaterialButton style="@style/Widget.Traffic.Button" android:id="@+id/cleanup_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="30dp" android:layout_marginEnd="30dp" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:textSize="16sp" app:cornerRadius="100dp" app:backgroundTint="@color/cleanup_action"/>
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/cleanup_progress" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" app:indicatorColor="@color/traffic_blue"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
