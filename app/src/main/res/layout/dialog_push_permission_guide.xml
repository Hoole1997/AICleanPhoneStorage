<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="42dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="118dp">
            <ImageView android:id="@+id/push_guide_illustration" android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center_horizontal|bottom" android:src="@drawable/push_permission_bell" android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/push_guide_close" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:padding="12dp" android:src="@drawable/ic_push_permission_close" android:contentDescription="@string/push_guide_close" android:background="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/push_guide_title" style="@style/Widget.Home.Text.Medium" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginHorizontal="32dp" android:gravity="center" android:text="@string/push_guide_title" android:textSize="18sp" android:textColor="#333333" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/push_guide_message" style="@style/Widget.Home.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginHorizontal="32dp" android:gravity="center" android:text="@string/push_guide_message" android:textSize="14sp" app:lineHeight="20sp" android:textColor="#666666" />
        <com.google.android.material.button.MaterialButton android:id="@+id/push_guide_allow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:layout_marginHorizontal="30dp" android:minHeight="48dp" android:paddingVertical="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:fontFamily="@font/home_roboto_medium" android:includeFontPadding="false" android:textAllCaps="false" android:letterSpacing="0" android:textSize="16sp" android:textColor="@android:color/white" android:text="@string/push_guide_allow" app:backgroundTint="#0D60F1" app:cornerRadius="24dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
