<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/home_progress_track" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:gravity="start">
            <shape><solid android:color="@color/home_surface" /><corners android:radius="12dp" /></shape>
        </scale>
    </item>
</layer-list>
