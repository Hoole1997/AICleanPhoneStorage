  "sheets": [
    {
      "sheet": "01-启动与首页",
      "events": [
        {
          "event": "app_launch",
          "title": "App 启动",
          "description": "App 启动时上报；启动链路：启动页 → （系统推送权限询问）→ 开屏 → 首页",
          "module": "启动与首页",
          "row": 2,
          "parameters": {
            "launch_type": {
              "title": "启动类型",
              "type": "字符串",
              "description": "冷启动或热启动",
              "enums": {
                "cold": "冷启动",
                "hot": "热启动"
              }
            },
            "user_type": {
              "title": "用户类型",
              "type": "字符串",
              "description": "买量/自然分流，与首页分流口径一致",
              "enums": {
                "paid": "买量用户（B 面）",
                "organic": "自然用户（A 面）"
              }
            }
          }
        },
        {
          "event": "page_show",
          "title": "页面展示",
          "description": "全局页面曝光事件，所有页面进入时上报；权限引导弹窗不单独设事件，由 perm_granted 参数覆盖",
          "module": "全局",
          "row": 6,
          "parameters": {
            "page": {
              "title": "页面标识",
              "type": "字符串",
              "description": "页面唯一标识",
              "enums": {
                "home": "首页",
                "junk": "垃圾清理二级页",
                "junk_detail": "垃圾清理三级页",
                "junk_result": "垃圾清理完成页",
                "traffic": "流量使用",
                "notify": "通知清理",
                "screenshots": "截图清理",
                "screenshots_result": "截图清理完成页",
                "photo": "照片压缩",
                "photo_result": "照片压缩完成页",
                "large": "大文件清理",
                "large_result": "大文件完成页",
                "apps": "应用管理",
                "unused": "未使用文件二级页",
                "unused_detail": "未使用文件三级页",
                "unused_result": "未使用文件完成页"
              }
            },
            "perm_granted": {
              "title": "权限状态",
              "type": "字符串",
              "description": "进入页面前是否已持有该功能所需权限（存储/用量访问/通知使用权）",
              "enums": {
                "true": "已授权",
                "false": "未授权",
                "none": "该页面无需权限"
              }
            }
          }
        },
        {
          "event": "page_leave",
          "title": "页面离开",
          "description": "离开页面时上报，与 page_show 配对",
          "module": "全局",
          "row": 25,
          "parameters": {
            "page": {
              "title": "页面标识",
              "type": "字符串",
              "description": "同 page_show 的 page 枚举",
              "enums": {}
            },
            "stay_duration": {
              "title": "停留时长",
              "type": "数值",
              "description": "页面停留时长，单位秒",
              "enums": {}
            }
          }
        },
        {
          "event": "home_state_show",
          "title": "首页状态展示",
          "description": "首页展示时上报当前状态；清理完成 3 分钟内为已清理态，其余为未清理态",
          "module": "启动与首页",
          "row": 27,
          "parameters": {
            "state": {
              "title": "首页状态",
              "type": "字符串",
              "description": "首页两态",
              "enums": {
                "dirty": "未清理",
                "cleaned": "已清理（3 分钟窗口内）"
              }
            },
            "junk_size": {
              "title": "垃圾量",
              "type": "数值",
              "description": "未清理态展示的可清理垃圾量，单位 MB；已清理态不传",
              "enums": {}
            }
          }
        },
        {
          "event": "clean_now_click",
          "title": "点击首页清理按钮",
          "description": "点击首页主卡清理按钮；未清理态诱导清理，已清理态不展示具体垃圾量但仍可点击",
          "module": "启动与首页",
          "row": 30,
          "parameters": {
            "state": {
              "title": "首页状态",
              "type": "字符串",
              "description": "点击时首页所处状态",
              "enums": {
                "dirty": "未清理",
                "cleaned": "已清理"
              }
            }
          }
        },
        {
          "event": "feature_entry_click",
          "title": "点击功能入口",
          "description": "点击首页功能入口；点击后先检测对应权限，未授权先弹权限引导",
          "module": "启动与首页",
          "row": 32,
          "parameters": {
            "entry": {
              "title": "功能入口",
              "type": "字符串",
              "description": "被点击的功能入口",
              "enums": {
                "junk": "垃圾清理（存储权限）",
                "traffic": "流量使用（用量访问权限）",
                "notify": "通知清理（通知使用权）",
                "screenshots": "截图清理（存储权限）",
                "photo": "照片压缩（存储权限）",
                "large": "大文件（存储权限）",
                "apps": "应用管理（免权限，queries 声明）",
                "unused": "未使用文件（存储权限）"
              }
            },
            "perm_granted": {
              "title": "权限状态",
              "type": "字符串",
              "description": "进入页面前是否已持有该功能所需权限（存储/用量访问/通知使用权）",
              "enums": {
                "true": "已授权",
                "false": "未授权",
                "none": "该页面无需权限"
              }
            }
          }
        },
        {
          "event": "rate_show",
          "title": "好评弹窗展示",
          "description": "好评弹窗展示，全局仅展示一次（首次冷启动进入首页后）",
          "module": "启动与首页",
          "row": 43,
          "parameters": {}
        },
        {
          "event": "rate_click",
          "title": "好评弹窗点击",
          "description": "好评弹窗打分/操作；默认 5 星，4-5 星跳转商店评论，1-3 星不跳转仅关闭",
          "module": "启动与首页",
          "row": 44,
          "parameters": {
            "stars": {
              "title": "评星",
              "type": "数值",
              "description": "用户选择的星数，1-5",
              "enums": {}
            },
            "action": {
              "title": "动作",
              "type": "字符串",
              "description": "打分后的行为",
              "enums": {
                "store": "跳转商店评论（4-5 星）",
                "close": "关闭弹窗（1-3 星）"
              }
            }
          }
        }
      ]
    },
    {
      "sheet": "02-垃圾清理",
