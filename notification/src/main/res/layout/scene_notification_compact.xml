<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 7136:4771：系统提供卡片外框/头部；内容限制在 Android 12+ 的 48dp 预算内。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/noti_bg_r16_white" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/sceneAppLogo" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/scene_layout_logo" android:importantForAccessibility="no" />
    <FrameLayout android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp">
        <ImageView android:id="@+id/iv" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/sceneIconSlot" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/sceneText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginHorizontal="8dp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"
        android:textSize="14sp" android:textColor="#333333" android:fontFamily="sans-serif" />
    <!-- 以文字自然高度确定按钮边界，避免 wrap_content FrameLayout 将唯一的动画子项测成默认 48dp。 -->
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageView android:id="@+id/sceneButtonStatic" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_alignStart="@id/tvAction" android:layout_alignEnd="@id/tvAction" android:layout_alignTop="@id/tvAction" android:layout_alignBottom="@id/tvAction"
            android:background="@drawable/scene_button_background" android:importantForAccessibility="no" />
        <ProgressBar android:id="@+id/sceneButtonMotion" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_alignStart="@id/tvAction" android:layout_alignEnd="@id/tvAction" android:layout_alignTop="@id/tvAction" android:layout_alignBottom="@id/tvAction"
            android:indeterminate="true" android:indeterminateTint="@null" android:indeterminateOnly="false" android:minHeight="0dp" android:minWidth="0dp"
            android:indeterminateDrawable="@drawable/scene_button_shimmer_compact" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tvAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="77dp" android:maxWidth="96dp"
            android:minHeight="32dp" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:gravity="center" android:includeFontPadding="false"
            android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" />
    </RelativeLayout>
</LinearLayout>
